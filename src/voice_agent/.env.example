# 复制到以下任一位置，服务启动时会自动加载：
#   ~/.config/voice_agent/.env
#   src/voice_agent/.env
#   工作区根目录/.env
# 或显式指定：export VOICE_AGENT_ENV=/path/to/.env

# 必填：小米 MiMo Token Plan API Key（tp- 或 ttp- 开头）
MIMO_API_KEY=tp-your_actual_token_plan_key_here
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# 语音模型
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖

# HTTP 服务
HOST=0.0.0.0
PORT=8000

# 可选：给 /api/* 加一个共享令牌。设置后网页需要在“令牌”框里填同样的值。
# 留空表示不校验（只建议在可信局域网使用）。
VOICE_AGENT_TOKEN=

# 可选：HTTPS。手机通过局域网访问时，浏览器只允许安全上下文使用麦克风。
# SSL_CERTFILE=/home/demo/.config/voice_agent/cert.pem
# SSL_KEYFILE=/home/demo/.config/voice_agent/key.pem

# 可选：覆盖默认人设提示词
# SYSTEM_PROMPT=你是运行在小车上的语音助手...
